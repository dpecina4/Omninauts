rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isNonNegInt(val) {
      return val is int && val >= 0 && val <= 1000000;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidElement(el) {
      return el is string && el in ['pyro', 'hydro', 'volt'];
    }

    function isValidCommanderProfile(data, userId) {
      return data.keys().hasAll([
               'userId', 'callsign', 'highestTutorialCleared', 'totalRescues',
               'totalExpeditions', 'bossesDefeated', 'fuelCells', 'sparkFlint',
               'magmaMatches', 'glassJars', 'dewVials', 'cryoCondensers',
               'capacitorChips', 'caveBatteries', 'copperCoils',
               'pyroEggs', 'hydroEggs', 'voltEggs', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'callsign', 'highestTutorialCleared', 'totalRescues',
               'totalExpeditions', 'bossesDefeated', 'fuelCells', 'sparkFlint',
               'magmaMatches', 'glassJars', 'dewVials', 'cryoCondensers',
               'capacitorChips', 'caveBatteries', 'copperCoils',
               'pyroEggs', 'hydroEggs', 'voltEggs', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId &&
             data.callsign is string && data.callsign.size() >= 1 && data.callsign.size() <= 40 &&
             data.highestTutorialCleared is int && data.highestTutorialCleared >= 0 && data.highestTutorialCleared <= 3 &&
             isNonNegInt(data.totalRescues) &&
             isNonNegInt(data.totalExpeditions) &&
             isNonNegInt(data.bossesDefeated) &&
             isNonNegInt(data.fuelCells) &&
             isNonNegInt(data.sparkFlint) &&
             isNonNegInt(data.magmaMatches) &&
             isNonNegInt(data.glassJars) &&
             isNonNegInt(data.dewVials) &&
             isNonNegInt(data.cryoCondensers) &&
             isNonNegInt(data.capacitorChips) &&
             isNonNegInt(data.caveBatteries) &&
             isNonNegInt(data.copperCoils) &&
             isNonNegInt(data.pyroEggs) &&
             isNonNegInt(data.hydroEggs) &&
             isNonNegInt(data.voltEggs) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidElementalLabState(data, userId, labId) {
      return data.keys().hasAll([
               'userId', 'elementId', 'unlocked', 'labTier', 'unlockedUpgrades',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'elementId', 'unlocked', 'labTier', 'unlockedUpgrades',
               'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId &&
             isValidElement(data.elementId) && data.elementId == labId &&
             data.unlocked is bool &&
             data.labTier is int && data.labTier >= 1 && data.labTier <= 5 &&
             data.unlockedUpgrades is list && data.unlockedUpgrades.size() <= 24 &&
             (data.unlockedUpgrades.size() == 0 || (data.unlockedUpgrades[0] is string && data.unlockedUpgrades[0].size() <= 64)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidLeaderState(data, userId, leaderId) {
      return data.keys().hasAll([
               'userId', 'elementId', 'name', 'unlocked', 'level', 'xp',
               'maxHp', 'attackPower', 'unlockedSkills', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'elementId', 'name', 'unlocked', 'level', 'xp',
               'maxHp', 'attackPower', 'unlockedSkills', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId &&
             isValidElement(data.elementId) && data.elementId == leaderId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 40 &&
             data.unlocked is bool &&
             data.level is int && data.level >= 1 && data.level <= 20 &&
             isNonNegInt(data.xp) &&
             data.maxHp is int && data.maxHp >= 50 && data.maxHp <= 5000 &&
             data.attackPower is int && data.attackPower >= 5 && data.attackPower <= 500 &&
             data.unlockedSkills is list && data.unlockedSkills.size() <= 12 &&
             (data.unlockedSkills.size() == 0 || (data.unlockedSkills[0] is string && data.unlockedSkills[0].size() <= 64)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidExpeditionRecord(data, userId) {
      return data.keys().hasAll([
               'userId', 'sectorId', 'sectorName', 'seed', 'biome', 'weather',
               'rescuedCount', 'totalPods', 'bossDefeated', 'victory', 'rank',
               'durationSeconds', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'sectorId', 'sectorName', 'seed', 'biome', 'weather',
               'rescuedCount', 'totalPods', 'bossDefeated', 'victory', 'rank',
               'durationSeconds', 'createdAt'
             ]) &&
             data.userId is string && data.userId == userId &&
             data.sectorId is string && data.sectorId.size() >= 1 && data.sectorId.size() <= 64 &&
             data.sectorName is string && data.sectorName.size() >= 1 && data.sectorName.size() <= 80 &&
             data.seed is int &&
             data.biome is string && data.biome in ['FUNGAL_GROTTO', 'BASALT_RIFT', 'CRYSTAL_CISTERN', 'DYNAMO_RUINS', 'STORM_CHASM'] &&
             data.weather is string && data.weather in ['CLEAR', 'SPORE_MIST', 'BRINE_RAIN', 'ION_SURGE', 'THERMAL_UPDRAFT'] &&
             data.rescuedCount is int && data.rescuedCount >= 0 && data.rescuedCount <= 20 &&
             data.totalPods is int && data.totalPods >= 1 && data.totalPods <= 20 &&
             data.bossDefeated is bool &&
             data.victory is bool &&
             data.rank is string && data.rank in ['S', 'A', 'B', 'C', 'F'] &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 7200 &&
             isValidTimestamp(data.createdAt);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       isValidCommanderProfile(incoming(), userId);

      allow update: if isValidId(userId) &&
                       isOwner(userId) &&
                       isValidCommanderProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'callsign', 'highestTutorialCleared', 'totalRescues',
                         'totalExpeditions', 'bossesDefeated', 'fuelCells', 'sparkFlint',
                         'magmaMatches', 'glassJars', 'dewVials', 'cryoCondensers',
                         'capacitorChips', 'caveBatteries', 'copperCoils',
                         'pyroEggs', 'hydroEggs', 'voltEggs', 'updatedAt'
                       ]);

      allow delete: if isValidId(userId) && isOwner(userId);

      match /labs/{labId} {
        allow get: if isValidId(userId) && isValidId(labId) && isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isValidId(userId) &&
                         isValidId(labId) &&
                         isOwner(userId) &&
                         isValidElementalLabState(incoming(), userId, labId);

        allow update: if isValidId(userId) &&
                         isValidId(labId) &&
                         isOwner(userId) &&
                         isValidElementalLabState(incoming(), userId, labId) &&
                         incoming().userId == existing().userId &&
                         incoming().elementId == existing().elementId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'unlocked', 'labTier', 'unlockedUpgrades', 'updatedAt'
                         ]);

        allow delete: if isValidId(userId) && isValidId(labId) && isOwner(userId);
      }

      match /leaders/{leaderId} {
        allow get: if isValidId(userId) && isValidId(leaderId) && isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isValidId(userId) &&
                         isValidId(leaderId) &&
                         isOwner(userId) &&
                         isValidLeaderState(incoming(), userId, leaderId);

        allow update: if isValidId(userId) &&
                         isValidId(leaderId) &&
                         isOwner(userId) &&
                         isValidLeaderState(incoming(), userId, leaderId) &&
                         incoming().userId == existing().userId &&
                         incoming().elementId == existing().elementId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'unlocked', 'level', 'xp', 'maxHp',
                           'attackPower', 'unlockedSkills', 'updatedAt'
                         ]);

        allow delete: if isValidId(userId) && isValidId(leaderId) && isOwner(userId);
      }

      match /expeditions/{expeditionId} {
        allow get: if isValidId(userId) && isValidId(expeditionId) && isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isValidId(userId) &&
                         isValidId(expeditionId) &&
                         isOwner(userId) &&
                         isValidExpeditionRecord(incoming(), userId);

        allow update: if false;

        allow delete: if isValidId(userId) && isValidId(expeditionId) && isOwner(userId);
      }
    }
  }
}
